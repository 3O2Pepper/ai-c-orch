# Neon Postgres connection string (required from Commit 3 onward)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Anthropic API key (required from Commit 4 onward)
ANTHROPIC_API_KEY=sk-ant-...

# --- Phase 3 (optional; features degrade cleanly when absent) ---

# E2B sandbox: executes generated code (Build verification, xlsx builds).
# Without it, code artifacts are delivered unverified and xlsx is unavailable.
# E2B_API_KEY=e2b_...

# Cloudflare R2 object storage: artifact content (required for binary
# artifacts like .xlsx; text artifacts fall back to inline Postgres).
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=ai-project-router
