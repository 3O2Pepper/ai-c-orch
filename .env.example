# Copy to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (pooled), e.g.
# postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Anthropic API key (env var only in Phase 1; api_keys table arrives in Phase 4)
ANTHROPIC_API_KEY=
